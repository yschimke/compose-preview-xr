material {
    name : panelShadow,
    shadingModel : unlit,
    blending : transparent,
    culling : none,
    parameters : [
        // A soft contact shadow cast behind/below a panel so it reads as floating. The shadow quad
        // is larger than the panel (the host inflates it by `blur`). Its shape is the panel's own
        // silhouette, the texture's alpha inside the panel's rounded rect, blurred across `blur`,
        // so an opaque panel casts a rounded-rect shadow and a transparent document (a 3D shape
        // drawn with no background) casts the shadow of what it draws rather than of its quad.
        // All extents are in the same aspect-corrected rect space the panel material uses.
        { type : sampler2d, name : content },   // the panel's texture (mipmapped)
        { type : float2, name : halfSize },     // panel half-extents (aspect-corrected)
        { type : float,  name : cornerRadius }, // panel corner radius
        { type : float,  name : blur },         // feather distance of the shadow edge
        { type : float4, name : color }         // straight-alpha shadow colour (rgb, peak alpha)
    ],
    requires : [ uv0 ]
}
fragment {
    float roundedBoxSdf(vec2 p, vec2 halfSize, float radius) {
        vec2 q = abs(p) - halfSize + vec2(radius);
        return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - radius;
    }

    // What the panel material draws at `uv`, as coverage: the texture's alpha inside the rounded
    // rect, zero outside it and outside the texture (no clamp-to-edge smear).
    float silhouette(vec2 uv, float lod) {
        if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return 0.0;
        vec2 p = (uv - 0.5) * 2.0 * materialParams.halfSize;
        float d = roundedBoxSdf(p, materialParams.halfSize, materialParams.cornerRadius);
        if (d > 0.0) return 0.0;
        return textureLod(materialParams_content, uv, lod).a;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // The shadow quad spans the inflated rect; map its UV to the panel's UV.
        float blur = max(materialParams.blur, 1e-4);
        vec2 outerHalf = materialParams.halfSize + vec2(blur);
        vec2 p = (getUV0() - 0.5) * 2.0 * outerHalf;
        vec2 uv = p / (2.0 * materialParams.halfSize) + 0.5;

        // Blur the silhouette across `blur`: a centre tap and two rings of eight, each read from a
        // mip level about as wide as the gap between taps so the disk has no visible steps.
        vec2 radius = vec2(blur) / (2.0 * materialParams.halfSize);
        vec2 texSize = vec2(textureSize(materialParams_content, 0));
        float lod = log2(max(1.0, 0.25 * max(radius.x * texSize.x, radius.y * texSize.y)));
        float sum = silhouette(uv, lod);
        float weight = 1.0;
        for (int i = 0; i < 8; i++) {
            float angle = float(i) * 0.7853982;
            vec2 dir = vec2(cos(angle), sin(angle));
            sum += 0.8 * silhouette(uv + dir * radius * 0.5, lod);
            sum += 0.45 * silhouette(uv + dir * radius, lod);
            weight += 0.8 + 0.45;
        }
        float coverage = sum / weight;

        // The rounded-rect falloff the shadow always had is the envelope: solid under the panel,
        // feathered to exactly zero at the inflated quad's edge, so no shadow is ever cut by its quad.
        float dist = roundedBoxSdf(p, materialParams.halfSize, materialParams.cornerRadius);
        float envelope = 1.0 - smoothstep(0.0, blur, dist);
        envelope = envelope * envelope;
        // Inside it, the shadow is as dense as the content above it. An opaque panel's blurred
        // silhouette stays above 0.5 out to its edge, so it keeps the envelope's full shadow; a
        // transparent document's only darkens where it draws.
        float a = materialParams.color.a * envelope * smoothstep(0.0, 0.5, coverage);
        material.baseColor = vec4(materialParams.color.rgb * a, a);
    }
}
